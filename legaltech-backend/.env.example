# Enable OpenAI-backed extraction of atomic legal risk signals.
# Keep false for deterministic local demos/tests without an API key.
AI_EXTRACTION_ENABLED=false

# Required only when AI_EXTRACTION_ENABLED=true.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Override as needed without changing code.
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=20
AI_EXTRACTION_MAX_CHARS=12000

# Optional PostgreSQL connection. The current prototype still uses InMemoryStore
# for application records; these settings enable DB health checks and schema setup.
DATABASE_URL=postgresql://legaltech:change-me@127.0.0.1:5432/legaltech
DATABASE_CONNECT_TIMEOUT_SECONDS=3
