# Development environment variables for Cloudflare Workers
# Copy this file to .dev.vars and fill in the values

# Backend URL (use local for development, production uses api-backend.flexforge.ai)
BACKEND_URL=http://localhost:4000

# Cloudflare Access Service Token (for authenticating to api-backend.flexforge.ai)
# Get these from Zero Trust Dashboard → Access → Service Tokens
CF_ACCESS_CLIENT_ID=your-client-id
CF_ACCESS_CLIENT_SECRET=your-client-secret

