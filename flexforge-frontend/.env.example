# FlexForge Frontend Environment Variables
# This file now covers both main FlexForge routes and /visualmind route.

# API URL - Backend server
# Development: Point to local backend
VITE_API_URL=http://localhost:4000/api/v1
# TransformHub shared API key for protected /transformhub requests
VITE_TRANSFORMHUB_API_KEY=th_dev_local_secret


# Production: Point to Cloudflare Workers edge (uncomment for production builds)
# VITE_API_URL=https://flexforge-edge.<your-subdomain>.workers.dev/api/v1

# Environment
VITE_ENV=development

# Turnstile (optional in local dev)
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# VITE_GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=your-client-id

# Microsoft auth (optional)
VITE_MICROSOFT_CLIENT_ID=your-microsoft-client-id
VITE_MICROSOFT_TENANT_ID=common

# VisualMind dev-only fallback bearer (keep disabled in production)
VITE_VM_ALLOW_DEV_BEARER=0
