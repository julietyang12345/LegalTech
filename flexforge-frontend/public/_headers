# Prevent caching of index.html (so new deploys are seen immediately)
/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Allow caching of hashed assets (JS, CSS) - they have unique filenames
/assets/*
  Cache-Control: public, max-age=31536000, immutable
