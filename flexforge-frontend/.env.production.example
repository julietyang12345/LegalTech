# FlexForge Frontend Production Environment Variables
# Copy this file to .env.production for production builds
# Used by both main app and /visualmind route.

# API URL - Cloudflare Workers edge API (api.flexforge.ai routes to flexforge-edge worker)
VITE_API_URL=https://api.flexforge.ai/api/v1
# TransformHub shared API key for protected /transformhub requests
VITE_TRANSFORMHUB_API_KEY=replace-with-production-transformhub-key


# Environment
VITE_ENV=production

# Auth providers
VITE_GOOGLE_CLIENT_ID=your-google-client-id
VITE_MICROSOFT_CLIENT_ID=your-microsoft-client-id
VITE_MICROSOFT_TENANT_ID=common

# Turnstile
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key

# VisualMind dev-only fallback bearer (must stay disabled in production)
VITE_VM_ALLOW_DEV_BEARER=0
